# Copy to .env (gitignored) and fill in. Read by gpubench-vast.
# Vast.ai API key: https://cloud.vast.ai/manage-keys/
VAST_API_KEY=
# GitHub fine-grained PAT, this repo only, permission "Contents: Read-only". Used by instances to clone.
GPUBENCH_GH_TOKEN=
# Optional: private key to use for ssh (default: OpenSSH picks ~/.ssh/id_*)
# GPUBENCH_SSH_KEY=C:/Users/you/.ssh/id_ed25519
